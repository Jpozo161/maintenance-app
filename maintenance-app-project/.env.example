
JWT_SECRET=690a361dc28cec4a2ce170b0e6eb165de6e73b3679cb11960374d13a434fcaf68992c1a2b4fe0b37fb4e09c221913670

# Opcionales (valor por defecto entre paréntesis).
PORT=                 # (3000)
CORS_ORIGIN=          # (http://localhost:5173)
APP_TIME_ZONE=        # (America/Bogota)
DB_HOST=              # (localhost)
DB_NAME=              # (mantenimiento)
NODE_ENV=             # production activa cookies "secure"

# S3: región, bucket privado y una credencial IAM limitada al bucket
# (GetObject, PutObject y DeleteObject). Ahí se guardan los documentos PDF de los mantenimientos.
# Después de llenarlas, comprueba la conexión con: npm run s3:check
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Opcional para S3 compatible o pruebas locales; en AWS dejar vacío.
S3_ENDPOINT=

# Notificaciones por correo (API Gateway -> Lambda -> SES).
# NOTIFICATIONS_API_URL: output "notification_endpoint" de Terraform, o la
#   Invoke URL del stage en la consola de API Gateway MAS la ruta del recurso.
#   Tiene que llevar stage y recurso; solo el host no llega al Lambda, API
#   Gateway responde 403 en el borde. Formato esperado:
#   https://<id>.execute-api.<region>.amazonaws.com/<stage>/<recurso>
#   (se acepta tambien el nombre antiguo APIGATEWAY_URL, pero este es el bueno)
# NOTIFICATIONS_API_KEY: debe coincidir con la variable notifications_api_key de
#   terraform.tfvars. Si el metodo tiene "API Key Required" y esto queda vacio,
#   el header x-api-key no se envia y la respuesta es 403.
# NOTIFICATIONS_RECIPIENT: destinatario por defecto. Mientras la cuenta SES
#   este en sandbox solo se puede enviar a direcciones verificadas.
# Si NOTIFICATIONS_API_URL queda vacia, la app no envia correos (no falla).
NOTIFICATIONS_API_URL=
NOTIFICATIONS_API_KEY=
NOTIFICATIONS_RECIPIENT=
NOTIFICATIONS_TIMEOUT_MS=   # (5000)
