# Copiar a .env y completar con la región, el bucket privado y una credencial IAM
# limitada al bucket (GetObject, PutObject y DeleteObject).
AWS_REGION=us-east-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Opcional para S3 compatible o pruebas locales; en AWS dejar vacío.
S3_ENDPOINT=
